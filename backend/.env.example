# Copy this file to `.env` and fill in your keys.
# You only need ONE of GEMINI_API_KEY or ANTHROPIC_API_KEY (whichever provider you pick).

# --- LLM provider ---
# "gemini" or "claude"
LLM_PROVIDER=gemini

# Google AI Studio key — get one at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Paths ---
# Folder of PDFs to ingest. Can be an absolute path; relative is resolved from backend/.
PDF_FOLDER=../pdfs

# Where ChromaDB persists its files.
CHROMA_DIR=./chroma_db

# --- Embedding ---
# Multilingual sentence-transformers model. Defaults below are a good balance.
# Bigger/better:  paraphrase-multilingual-mpnet-base-v2  (~420MB, higher quality German)
# Smaller/faster: paraphrase-multilingual-MiniLM-L12-v2  (~120MB, default)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Retrieval ---
TOP_K=6                       # How many chunks to return per query
MIN_SIMILARITY=0.25           # Drop chunks below this cosine similarity
